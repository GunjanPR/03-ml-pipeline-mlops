{
 "uid": "readmission-api",
 "title": "Readmission model - serving & drift",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "mlops",
  "readmission"
 ],
 "timezone": "browser",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Predictions / s",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(mlp_predictions_total[1m]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Serving model version",
   "description": "Registry version of the champion baked into the running image.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(mlp_model_version)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "gauge",
   "title": "Feature drift share",
   "description": "Share of features Evidently flags as drifted in the last check (alert at 30%).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(mlp_drift_share)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.15
       },
       {
        "color": "red",
        "value": 0.3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Drift detected",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(mlp_drift_detected)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "no",
         "color": "green"
        },
        "1": {
         "text": "YES",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Hours since drift check",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(time() - max(mlp_drift_last_check_timestamp)) / 3600",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "h"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Rejected calls (5m)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(mlp_predict_errors_total[5m])) or vector(0)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "/predict latency",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(mlp_predict_latency_seconds_bucket[1m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(mlp_predict_latency_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(mlp_predict_latency_seconds_bucket[1m])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Flag rate and mean predicted risk",
   "description": "Output drift: a move here without a matching move in inputs points at the model.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(mlp_positive_predictions_total[5m])) / sum(rate(mlp_predictions_total[5m]))",
     "legendFormat": "flagged share",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(mlp_predicted_probability_sum[5m])) / sum(rate(mlp_predicted_probability_count[5m]))",
     "legendFormat": "mean probability",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "heatmap",
   "title": "Predicted probability distribution",
   "description": "Each column is one minute; rows are predicted-probability buckets (upper bound).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (le) (increase(mlp_predicted_probability_bucket[1m]))",
     "legendFormat": "{{le}}",
     "refId": "A",
     "format": "heatmap"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "calculate": false,
    "yAxis": {
     "unit": "short",
     "decimals": 2
    },
    "cellGap": 1,
    "color": {
     "scheme": "Oranges",
     "mode": "scheme"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Rows per call",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(mlp_predict_batch_size_sum[5m])) / sum(rate(mlp_predict_batch_size_count[5m]))",
     "legendFormat": "mean batch size",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}