# Copy to .env and fill in. Never commit .env.
# ---- MLflow ----
# Local SQLite store (default; MLflow 3 deprecates ./mlruns) or a server, e.g. http://localhost:5000
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ml-pipeline
REGISTERED_MODEL_NAME=tabular-classifier

# ---- Data / DVC ----
DATA_DIR=./data
# Name of the configured DVC remote (see `dvc remote add`)
DVC_REMOTE=
# Kaggle credentials, only if the chosen dataset comes from Kaggle
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- Training ----
RANDOM_SEED=42
OPTUNA_N_TRIALS=50

# ---- Quality gate / monitoring ----
# Minimum ROC-AUC improvement over the baseline required for promotion
MIN_AUC_LIFT=0.01
# Share of drifted features that triggers an alert / retrain (0-1)
DRIFT_THRESHOLD=0.3

# ---- Serving ----
API_HOST=0.0.0.0
API_PORT=8020
# debug | info | warning | error
LOG_LEVEL=info
